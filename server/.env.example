# Credenciais apenas para desenvolvimento, conforme docker-compose.yml.
DATABASE_URL="postgresql://portal138:portal138_dev@localhost:5433/portal138"
# DATABASE_SSL_CA=""
PORT=3000

# Gere um segredo aleatório conforme o README antes de iniciar a API.
# Obrigatório: pelo menos 32 caracteres. Não compartilhe nem versione o valor.
JWT_SECRET=""
JWT_EXPIRES_IN="1h"

# Opcional: pasta persistente das imagens. Caminho relativo à pasta server ou absoluto.
# UPLOAD_DIR="uploads"
UPLOAD_STORAGE="local"
# Para salvar imagens fora do servidor, veja docs/hosting-free.md.
# SUPABASE_URL="https://SEU-PROJETO.supabase.co"
# SUPABASE_SECRET_KEY=""
# SUPABASE_STORAGE_BUCKET="portal-capas"

# Desenvolvimento usa Vite; produção serve client/dist pela API por padrão.
NODE_ENV="development"
# SERVE_CLIENT="false"
# CLIENT_DIST_DIR="../client/dist"
# TRUST_PROXY=0
# CORS_ORIGINS=""
