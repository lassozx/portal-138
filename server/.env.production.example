# Copie para server/.env apenas no ambiente de produção e preencha seus valores.
NODE_ENV="production"
PORT=3000
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:5432/portal138"
# Certificado CA PEM do provedor, quando necessário para verificar TLS.
# DATABASE_SSL_CA=""
# Gere um segredo próprio com pelo menos 32 caracteres.
JWT_SECRET=""
JWT_EXPIRES_IN="1h"

# Servir o build de client/dist junto com a API.
SERVE_CLIENT="true"
CLIENT_DIST_DIR="../client/dist"

# Configure uma pasta em volume persistente na hospedagem.
UPLOAD_DIR="uploads"
UPLOAD_STORAGE="local"
# Render Free usa UPLOAD_STORAGE="supabase" e as três variáveis abaixo.
# SUPABASE_URL="https://SEU-PROJETO.supabase.co"
# SUPABASE_SECRET_KEY=""
# SUPABASE_STORAGE_BUCKET="portal-capas"

# Quantidade de proxies confiáveis entre a internet e a API (0 = acesso direto).
TRUST_PROXY=0
# Deixe vazio para o site e API na mesma origem.
# Se hospedar o cliente em outro domínio, informe a origem HTTPS exata.
CORS_ORIGINS=""
